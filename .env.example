# -----------------------------------------------------------------------------
# School Admission Portal — Frontend Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your own BaaS / REST API.
# Only variables prefixed with `VITE_` are exposed to the browser.
# -----------------------------------------------------------------------------

# Base URL of your backend REST API (no trailing slash).
# Examples:
#   http://localhost:4000/api
#   https://api.myschool.com/v1
VITE_API_BASE_URL=http://localhost:4000/api

# Optional: a static API key/token sent in the `X-Api-Key` header on every
# request. Leave empty if your backend doesn't require it. Per-user auth uses
# a JWT that is issued by /auth/login and stored in localStorage automatically.
VITE_API_KEY=
