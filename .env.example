# -----------------------------------------------------------------------------
# School Admission Portal — environment variables
# Copy this file to `.env` and fill in values from your Pluto dashboard
# (Dashboard → Tokens). Only variables prefixed with `VITE_` are exposed to
# the browser bundle.
# -----------------------------------------------------------------------------

# --- Browser-visible ----------------------------------------------------------
VITE_PLUTO_URL=https://api.timescard.cloud
VITE_PLUTO_ANON_KEY=pk_anon_xxxxx

# --- SERVER ONLY --------------------------------------------------------------
# Used by TanStack server functions in src/lib/*.functions.ts via
# src/lib/pluto-admin.server.ts. Bypasses RLS — treat like a root password.
# NEVER rename to VITE_PLUTO_SERVICE_ROLE_KEY: any VITE_* value is inlined
# into the JS bundle and becomes public.
PLUTO_URL=https://api.timescard.cloud
PLUTO_SERVICE_ROLE_KEY=sk_svc_xxxxx
