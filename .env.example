# -----------------------------------------------------------------------------
# School Admission Portal — Frontend Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Pluto dashboard
# (Dashboard → Tokens). Only variables prefixed with `VITE_` are exposed to
# the browser.
# -----------------------------------------------------------------------------

# Base URL of your Pluto project's API gateway.
VITE_PLUTO_URL=https://api.timescard.cloud

# Publishable (anon) API key — safe to ship in the browser bundle.
# Row Level Security policies on the Pluto side must enforce access.
VITE_PLUTO_ANON_KEY=pk_anon_xxxxx

# -----------------------------------------------------------------------------
# NEVER put the service-role key in this file or in any VITE_* variable —
# it bypasses RLS and must live only on your own server / edge functions:
#
#   PLUTO_SERVICE_ROLE_KEY=sk_svc_xxxxx
# -----------------------------------------------------------------------------
