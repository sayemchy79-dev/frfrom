# Pluto BaaS (Supabase / PostgREST-compatible).
# Only VITE_* variables are exposed to the browser.
VITE_PLUTO_URL=https://api.timescard.cloud
VITE_PLUTO_ANON_KEY=pk_anon_xxxxx

# --- SERVER ONLY --------------------------------------------------------------
# NEVER prefix the service-role key with VITE_ — that would ship it to the
# browser bundle and let anyone bypass row-level security.
PLUTO_URL=https://api.timescard.cloud
PLUTO_SERVICE_ROLE_KEY=sk_svc_xxxxx
